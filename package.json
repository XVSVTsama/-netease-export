{
  "name": "netease-export",
  "version": "1.4.19",
  "private": true,
  "type": "module",
  "description": "网易云歌单 / 收藏导出与本地面板",
  "author": "XVSVTsama",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "panel": "node web/server.mjs",
    "start": "electron .",
    "dist:win": "electron-builder --win dir",
    "dist:dir": "electron-builder --dir",
    "sync": "node runner.mjs sync",
    "tidy": "node runner.mjs tidy",
    "check": "node runner.mjs check",
    "build": "node build.mjs",
    "tauri": "tauri",
    "dist:android": "tauri android build --apk",
    "android:init": "tauri android init --ci",
    "sync:ui": "node scripts/sync-ui.mjs",
    "test:ui": "node scripts/ui-check.mjs"
  },
  "build": {
    "appId": "app.xvsvt.netease.export",
    "productName": "网易云导出",
    "asar": false,
    "files": [
      "main.cjs",
      "web/**/*",
      "*.mjs",
      "build.sh",
      "accounts.example.json"
    ],
    "extraMetadata": {
      "main": "main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "@tauri-apps/cli": "^2"
  },
  "dependencies": {
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-armenian": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-ethiopic": "^5.3.0",
    "@fontsource/noto-sans-georgian": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@fontsource/noto-sans-khmer": "^5.3.0",
    "@fontsource/noto-sans-lao": "^5.3.0",
    "@fontsource/noto-sans-myanmar": "^5.3.0",
    "@fontsource/noto-sans-sinhala": "^5.3.0",
    "@fontsource/noto-sans-symbols-2": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fontsource/noto-sans-yi": "^5.3.0",
    "@fontsource/noto-serif-tibetan": "^5.3.0",
    "qrcode": "^1.5.4",
    "undici": "^7.0.0"
  }
}
