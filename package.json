{
  "name": "netease-export-desktop",
  "version": "1.0.0",
  "description": "网易云歌单/收藏导出桌面版",
  "main": "main.js",
  "author": "XVSVTsama",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win dir",
    "dist:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "app.xvsvt.netease.export",
    "productName": "网易云导出",
    "files": [
      "main.js",
      "web/**/*",
      "*.mjs",
      "build.sh",
      "accounts.example.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-armenian": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-ethiopic": "^5.3.0",
    "@fontsource/noto-sans-georgian": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@fontsource/noto-sans-khmer": "^5.3.0",
    "@fontsource/noto-sans-lao": "^5.3.0",
    "@fontsource/noto-sans-myanmar": "^5.3.0",
    "@fontsource/noto-sans-sinhala": "^5.3.0",
    "@fontsource/noto-sans-symbols-2": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fontsource/noto-sans-yi": "^5.3.0",
    "@fontsource/noto-serif-tibetan": "^5.3.0",
    "qrcode": "^1.5.4",
    "undici": "^7.0.0"
  }
}