{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "netease-export",
  "version": "1.4.17",
  "identifier": "app.xvsvt.netease.export",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run sync:ui",
    "beforeDevCommand": "npm run sync:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "网易云导出",
        "width": 900,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
